<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <IsTestProject>false</IsTestProject>
    <_RefProject>InterfaceBaseInvoke.Tests.AssemblyToProcess</_RefProject>
    <_RefProjectDir>..\$(_RefProject)\</_RefProjectDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectCapability Remove="TestContainer" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="$(_RefProjectDir)**\*.cs"
             Exclude="$(_RefProjectDir)obj\**;$(_RefProjectDir)AssemblyToProcessReference.cs"
             Link="$(_RefProject)\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3.assert" />
    <PackageReference Include="xunit.v3.extensibility.core" />
    <ProjectReference Include="..\..\src\InterfaceBaseInvoke\InterfaceBaseInvoke.csproj" />
  </ItemGroup>
</Project>
